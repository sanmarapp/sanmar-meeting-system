<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking Status Update</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f3f0; margin: 0; padding: 0; }
    .container { max-width: 560px; margin: 32px auto; background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #e8e3dd; }
    .header { background: #1A1614; padding: 24px 32px; }
    .header h1 { color: #C9A97A; margin: 0; font-size: 18px; font-weight: 600; }
    .header p { color: rgba(255,255,255,0.45); margin: 4px 0 0; font-size: 12px; }
    .body { padding: 28px 32px; }
    .status-approved { background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.25); border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; color: #15803d; font-size: 13px; font-weight: 600; }
    .status-rejected { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; color: #b91c1c; font-size: 13px; font-weight: 600; }
    .card { background: #fafaf9; border: 1px solid #ede9e4; border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; }
    .row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f0ede9; }
    .row:last-child { border-bottom: none; }
    .label { font-size: 12px; color: #9b8a7a; }
    .value { font-size: 13px; color: #1a1614; font-weight: 500; text-align: right; }
    .footer { padding: 16px 32px; background: #fafaf9; border-top: 1px solid #ede9e4; font-size: 11px; color: #b0a090; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Sanmar Properties</h1>
      <p>Meeting & Workspace Management</p>
    </div>
    <div class="body">
      <p style="font-size:15px;color:#1a1614;">Hi {{name}},</p>

      {{#if approved}}
      <div class="status-approved">✅ Your booking has been approved.</div>
      {{else}}
      <div class="status-rejected">❌ Your booking has been rejected.{{#if reason}} Reason: {{reason}}{{/if}}</div>
      {{/if}}

      <div class="card">
        <div class="row">
          <span class="label">Booking ID</span>
          <span class="value">#{{bookingId}}</span>
        </div>
        <div class="row">
          <span class="label">Meeting Title</span>
          <span class="value">{{title}}</span>
        </div>
        <div class="row">
          <span class="label">Room</span>
          <span class="value">{{roomName}}</span>
        </div>
        <div class="row">
          <span class="label">Date</span>
          <span class="value">{{date}}</span>
        </div>
        <div class="row">
          <span class="label">Start Time</span>
          <span class="value">{{startTime}}</span>
        </div>
      </div>

      {{#unless approved}}
      <p style="color:#4a3f35;font-size:13px;">You may submit a new booking request with adjusted details.</p>
      {{/unless}}
    </div>
    <div class="footer">
      Sanmar Properties Ltd. · This is an automated notification, please do not reply.
    </div>
  </div>
</body>
</html>
